APP_ENV=production
SECRET_KEY=replace-with-at-least-32-random-characters
ADMIN_PASSWORD=replace-with-a-strong-administrator-password
DATABASE_URL=postgresql+asyncpg://deetrader:change-me@postgres:5432/deetrader
POSTGRES_DB=deetrader
POSTGRES_USER=deetrader
POSTGRES_PASSWORD=change-me
REDIS_URL=redis://redis:6379/0
TRADING_MODE=paper
EXECUTION_MODE=manual
LIVE_TRADING_ENABLED=false
BROKER_PROVIDER=ibkr
IBKR_BASE_URL=https://host.docker.internal:5000/v1/api
IBKR_ACCOUNT_ID=DU123456
IBKR_ACCESS_TOKEN=
IBKR_VERIFY_TLS=false
IBKR_TIMEOUT_SECONDS=10
IBKR_ORDER_SUBMISSION_ENABLED=false
IBKR_ORDER_PAYLOAD_STYLE=orders_object
AI_PROVIDER=disabled
MARKET_DATA_PROVIDER=mock
MAX_PRICE_AGE_SECONDS=15
CORS_ORIGINS=["http://localhost:3000"]
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
